# Base de datos y seguridad
DATABASE_URL=postgresql://usuario:password@servidor/base_de_datos
JWT_SECRET=cambie-esta-clave-por-una-larga-y-segura
SANDBOX_ENABLED=false
SANDBOX_EMAIL=demo@verduleria.local
SANDBOX_PASSWORD=use-una-clave-segura-solo-para-demostracion
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=20000

# Dirección pública del frontend. El enlace del correo regresará aquí.
FRONTEND_URL=http://localhost:8081

# Servidor de correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=correo-de-la-verduleria@gmail.com
SMTP_PASS=contraseña-de-aplicacion-del-correo
SMTP_FROM=Verdulería Jerusalén <correo-de-la-verduleria@gmail.com>

# Firebase Admin (notificaciones push). Use variables separadas o FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=identificador-del-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
