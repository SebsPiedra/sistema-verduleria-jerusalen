{
  "expo": {
    "name": "Verdulería Jerusalén",
    "slug": "verduleria-jerusalen",
    "description": "Sistema móvil para consultar productos, realizar pedidos y administrar la Verdulería Jerusalén.",
    "githubUrl": "https://github.com/SebsPiedra/sistema-verduleria-jerusalen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verduleriajerusalen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sebaspiedra.verduleriajerusalen",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.sebaspiedra.verduleriajerusalen",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que Verdulería Jerusalén use Face ID para proteger el acceso a su cuenta."
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "897edcda-22b2-483b-a430-2ebe7362df73"
      }
    }
  }
}
